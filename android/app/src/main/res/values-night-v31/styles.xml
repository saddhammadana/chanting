<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ draws its own splash from a ground colour and one centred
         image. No text, no animation from a GIF: the app's name, the rippling
         lotus and the three dots begin once Flutter is up (LoadingIndicator). -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">@color/splash_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_lotus</item>
    </style>
</resources>
