  "aboutSectionAbout": "About",
  "aboutDescription": "A Thai–Pali prayer book that works entirely offline. The prayers follow the standard prayer books in common use. If you find a mistake, please check it against the prayer book you rely on.",
  "aboutSectionScript": "Script & transliteration",
  "@aboutSectionScript": {
    "description": "Heading for the script section on the About screen — the chant text is Pali in Thai script, the companion field is Pali in Roman script"
  },
  "aboutScriptThaiTitle": "Chant text — Pali in Thai script",
  "aboutScriptThaiBody": "The chant field is a reading guide for chanting, not Pali spelling. It breaks consonant clusters so they can be said aloud (dvi is written ทะวิ) and lengthens vowels the way they are actually chanted (añjali is written อัญชะลี). Transliterating the Thai reading back into Roman letters therefore produces misspelled Pali.",
  "@aboutScriptThaiBody": {
    "description": "Explains that the Thai-script reading is a pronunciation guide, not orthography — both examples are real errors that were found and fixed, recorded in docs/roadmap/todo.md"
  },
  "aboutScriptRomanTitle": "Roman — transliterated Pali",
  "aboutScriptRomanBody": "The Roman field is transliterated from the Pali word forms, using diacritics for sounds plain Roman letters cannot show.",
  "@aboutScriptRomanBody": {
    "description": "Lead-in above the diacritics table"
  },
  "aboutScriptLongVowel": "Long vowel",
  "@aboutScriptLongVowel": {
    "description": "Meaning of the macron in the diacritics table"
  },
  "aboutScriptRetroflex": "Retroflex (dot below)",
  "@aboutScriptRetroflex": {
    "description": "Meaning of the dot below in the diacritics table. It corresponds to retroflex consonants in Thai script."
  },
  "aboutScriptVelarNasal": "Nasal, matching ง",
  "@aboutScriptVelarNasal": {
    "description": "Meaning of ṅ in the diacritics table"
  },
  "aboutScriptPalatalNasal": "Nasal, matching ญ",
  "@aboutScriptPalatalNasal": {
    "description": "Meaning of ñ in the diacritics table"
  },
  "aboutScriptNiggahita": "Niggahita",
  "@aboutScriptNiggahita": {
    "description": "Meaning of ṃ in the diacritics table"
  },
  "aboutScriptNiggahitaNote": "Two conventions for niggahita are both in use — dot below ṃ (IAST) and dot above ṁ (PTS). This app uses dot below everywhere. The sources it was transliterated from are entirely in Thai script, which always writes niggahita above the letter, so no printed edition settles which Roman form is right. This is a transliteration convention, not a change to the text.",
  "@aboutScriptNiggahitaNote": {
    "description": "Note under the diacritics table — do not loosely call one form 'the IAST/PTS way'; the two schools disagree. See docs/content/prayer-schema.md section 3"
  },
