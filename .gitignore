# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/
# Docker Compose copies APK/AAB outputs from build volumes into this folder.
/dist/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# gen-l10n regenerates these files from lib/l10n/*.arb during `flutter pub get`
# and Flutter builds. Flutter 3.44 removed the synthetic flutter_gen package, so
# generated localization files live under lib/. Do not commit them; CI generates
# them before analyze/test.
/lib/l10n/app_localizations*.dart

# Release signing material. Never commit these; losing the Play signing key can
# make future app updates impossible. android/.gitignore also covers the Android
# folder, but docker-compose.yml documents an optional root-level .jks mount.
*.jks
*.keystore
key.properties

# Failed golden-test diff output. It is always regenerated locally.
test/failures/

# Report dropped in the project root by an audit tool that lives outside this
# repository. Nothing here reads it and it is regenerated on every run.
/premium-audit.json
